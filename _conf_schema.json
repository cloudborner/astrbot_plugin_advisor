{
  "general": {
    "description": "插件顾问",
    "type": "object",
    "items": {
      "qq_whitelist": {
        "description": "QQ号白名单",
        "type": "list",
        "items": {"type": "string"},
        "default": [],
        "hint": "只有列表中的QQ号可以发起需求分析。每项填写一个QQ号；列表为空时所有人都无法使用。"
      },
      "provider_id": {
        "description": "群需求分析模型",
        "type": "string",
        "default": "",
        "hint": "留空时使用当前会话模型。确认分词后，模型会读取去身份化的聊天上下文；聊天中的指令不会被执行。",
        "_special": "select_provider"
      },
      "enable_image_analysis": {
        "description": "分析图片内容",
        "type": "bool",
        "default": true,
        "hint": "模型支持图片时会结合有限图片理解群需求；不支持时自动完成文字分析并在报告中说明。"
      },
      "recommendation_limit": {
        "description": "每次推荐数量",
        "type": "int",
        "default": 8,
        "hint": "范围 1–20。没有足够合适的插件时不会为了凑数而推荐。",
        "slider": {"min": 1, "max": 20, "step": 1}
      }
    }
  },
  "advanced": {
    "description": "高级设置",
    "type": "object",
    "items": {
      "phrase_preview_limit": {
        "description": "默认显示词组数量",
        "type": "int",
        "default": 15,
        "hint": "词组确认页默认显示的数量。其余词组只是隐藏，仍会参加分析。",
        "slider": {"min": 5, "max": 50, "step": 1}
      },
      "max_images_for_analysis": {
        "description": "单次分析图片上限",
        "type": "int",
        "default": 8,
        "hint": "从聊天时间范围内分散选择图片，范围 1–20。数值越大，模型调用可能越慢。",
        "slider": {"min": 1, "max": 20, "step": 1}
      },
      "blacklist_words": {
        "description": "自定义黑名单词汇",
        "type": "list",
        "items": {"type": "string"},
        "default": [],
        "hint": "这些词组不会进入词组确认和需求分析。留空时仍会使用内置的少量平台噪声过滤。"
      },
      "blacklist_regexes": {
        "description": "自定义黑名单正则",
        "type": "list",
        "items": {"type": "string"},
        "default": [],
        "hint": "用于过滤固定格式的噪声。无效或过长的规则会被忽略。"
      },
      "history_message_limit": {
        "description": "单次历史读取上限",
        "type": "int",
        "default": 1000,
        "hint": "同时限制需求分析和手动导出的消息数量。低配置服务器建议保持默认值。",
        "slider": {"min": 100, "max": 5000, "step": 100}
      },
      "minimum_messages_for_analysis": {
        "description": "最少有效消息数",
        "type": "int",
        "default": 30,
        "hint": "清洗后的消息少于此数量时不开始正式分析。",
        "slider": {"min": 5, "max": 1000, "step": 5}
      },
      "statistics_retention_days": {
        "description": "统计数据保留天数",
        "type": "int",
        "default": 30,
        "hint": "过期统计会自动清理；本次模型上下文不会写入长期统计文件。",
        "slider": {"min": 1, "max": 365, "step": 1}
      },
      "minimum_recommendation_score": {
        "description": "最低推荐分",
        "type": "float",
        "default": 40.0,
        "hint": "范围 0–100。低于该分数的插件不会进入建议安装列表。",
        "slider": {"min": 0, "max": 100, "step": 1}
      },
      "report_detail": {
        "description": "报告详细程度",
        "type": "string",
        "default": "standard",
        "options": ["compact", "standard", "detailed"],
        "labels": ["精简", "标准", "详细"]
      },
      "render_reports_as_image": {
        "description": "发送图片报告",
        "type": "bool",
        "default": true,
        "hint": "关闭后发送纯文字；图片渲染失败时也会自动改发文字。"
      },
      "llm_timeout_seconds": {
        "description": "模型最长等待时间（秒）",
        "type": "int",
        "default": 45,
        "hint": "范围 5–120 秒；超出范围会采用边界值并写入 AstrBot 日志。超时后明确报告失败，不会伪装成分析成功。",
        "slider": {"min": 5, "max": 120, "step": 5}
      },
      "enable_logging": {
        "description": "记录运行日志",
        "type": "bool",
        "default": true,
        "hint": "只记录状态、数量和耗时，不记录聊天原文、QQ号或模型凭据。"
      },
      "enable_llm_fallback": {
        "description": "复核新插件资源风险",
        "type": "bool",
        "default": false,
        "hint": "资料不足的新插件可额外调用模型复核资源风险；模型只能提高风险，不能无依据降低风险。"
      }
    }
  }
}
