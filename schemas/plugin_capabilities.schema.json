{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstrBot Plugin Advisor Capability Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["$meta", "profiles"],
  "properties": {
    "$meta": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "market_version",
        "profile_count",
        "generation_mode",
        "source_code_downloaded",
        "profiles_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "generated_at": {"type": "string", "maxLength": 64},
        "market_version": {"type": "string", "maxLength": 128},
        "profile_count": {"type": "integer", "minimum": 1, "maximum": 5000},
        "generation_mode": {
          "const": "market_metadata_and_deterministic_taxonomy"
        },
        "source_code_downloaded": {"const": false},
        "profiles_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "profiles": {
      "type": "object",
      "maxProperties": 5000,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "termList": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 2, "maxLength": 80},
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "version",
        "summary",
        "capabilities",
        "aliases",
        "use_cases",
        "limitations",
        "sources",
        "confidence"
      ],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1, "maxLength": 300},
        "version": {"type": "string", "maxLength": 64},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "capabilities": {"$ref": "#/$defs/termList"},
        "aliases": {"$ref": "#/$defs/termList"},
        "use_cases": {"$ref": "#/$defs/termList"},
        "limitations": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 2, "maxLength": 160},
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 2, "maxLength": 40},
          "uniqueItems": true
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
